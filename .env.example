# ═══════════════════════════════════════════════
#  NicoDev Discord Bot – Configurazione
# ═══════════════════════════════════════════════

# Token del bot Discord (obbligatorio)
DISCORD_TOKEN=IL_TUO_TOKEN_QUI

# Client ID del bot (obbligatorio per registrare i comandi slash)
CLIENT_ID=IL_TUO_CLIENT_ID_QUI

# ID del server Discord (opzionale, per deploy comandi su un solo server durante lo sviluppo)
GUILD_ID=

# Colore embed predefinito (hex)
EMBED_COLOR=#5865F2

# Nome del bot (personalizzabile)
BOT_NAME=NicoDev Bot

# Twitch API (opzionale, per notifiche live)
# Ottieni le credenziali su https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
